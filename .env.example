# ---- copy to .env and fill in. NEVER commit the real .env ----

# Postgres connection string. Works with Supabase, Render Postgres, or any Postgres.
#   Supabase: Project Settings → Database → Connection string (URI), use the "Session" pooler.
#   Render:   the Internal Database URL of your Render Postgres instance.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Set to "true" only for a local dev Postgres without SSL. Leave unset in the cloud.
DATABASE_NO_SSL=

# Your timezone. Decides what "today" means when you log a workout late at night —
# without this a 01:00 session lands on the previous day. Any IANA name.
TIMEZONE=Europe/Riga

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Reads workout data off photos (bike computer / machine displays).
OPENAI_VISION_MODEL=gpt-4o-mini
# Transcribes Telegram voice notes.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# How many earlier chat turns the bot remembers, so follow-ups like "make it 8 reps"
# know what they refer to. Default 20. Send /reset in Telegram to clear the thread.
CHAT_HISTORY_TURNS=20

# Telegram — create a bot with @BotFather, paste the token here.
TELEGRAM_BOT_TOKEN=123456:ABC...
# A random string you invent (e.g. `openssl rand -hex 16`). Telegram echoes it back so
# we can reject forged webhook calls.
TELEGRAM_WEBHOOK_SECRET=change-me-to-random-hex
# Only this Telegram user id may talk to the bot. Message the bot once while this is
# empty and it will reply with your id; then paste it here and redeploy.
ALLOWED_TELEGRAM_USER_ID=

# Web frontend single-user login.
AUTH_USERNAME=kasra
# bcrypt hash of your password — generate with:  node scripts/hash-password.js "yourpassword"
AUTH_PASSWORD_HASH=
# Random secret used to sign the login session cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-random-hex

# The public URL Render assigns your service, e.g. https://gym-tracker.onrender.com
# Used to register the Telegram webhook on startup. Leave empty for local polling.
PUBLIC_URL=

# Port (Render sets this automatically; default 8731 locally).
PORT=8731

# ---- Proactive digest: the bot messages you instead of only answering ----
# Must be exactly "true" to switch on. Off by default so nothing surprises you.
DIGEST_ENABLED=
# Local hour (per TIMEZONE) to send. Default 19.
DIGEST_HOUR=19
# Weekday for the weekly recap: 0=Sunday. Other days get the short nudge only.
DIGEST_WEEKLY_DAY=0

# ---- Strava ride import (optional; only needed for scripts/import-strava.js) ----
# Create an API app at https://www.strava.com/settings/api, then authorize with
# scope activity:read_all — see the README for the full walkthrough.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
