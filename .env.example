# ---- copy to .env and fill in. NEVER commit a real .env ----
#
# Only variables that must be set are listed. Anything with a working default lives in
# src/config.js instead - see ENV_REFERENCE.md for the full list of defaults and how to
# override one if you ever need to.
#
# Every variable here appears in .env.example and .env alike, in the same order. Only
# the values differ. Keep them in sync.
#
# Every value is validated at boot: a missing or malformed one stops the process with a
# message naming it, rather than starting a server that is quietly insecure.

# production | development
# Turns on the strict checks: SESSION_SECRET becomes mandatory, the session cookie
# becomes Secure-only, and the Telegram allowlist may not be empty.
NODE_ENV=production

# Public HTTPS origin. Telegram registers its webhook here and rejects plain http://.
PUBLIC_URL=https://gym.reinis.site

# Postgres. TLS is derived from the host: loopback connects without it, anything remote
# must present a certificate that verifies.
DATABASE_URL=postgres://gym_tracker:PASSWORD@127.0.0.1:5432/gym_tracker

# ---- dashboard login ----
AUTH_USERNAME=
# bcrypt hash - generate with:  node scripts/hash-password.js "yourpassword"
# Contains `$`. Safe here and in a systemd EnvironmentFile (neither expands variables),
# but must be single-quoted in any shell command.
AUTH_PASSWORD_HASH=
# Signs the session cookie. Mandatory in production, minimum 32 characters.
# Generate with:  openssl rand -hex 32
# Anyone who learns this can mint a valid session without knowing the password.
SESSION_SECRET=

# ---- OpenAI ----
OPENAI_API_KEY=

# ---- Telegram ----
# Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
# The webhook's ONLY defence - Telegram echoes it back so forged calls can be rejected.
# Minimum 16 characters. The app refuses to start if a bot token is set without one.
# Generate with:  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Only this Telegram user id may talk to the bot. Mandatory in production. To find it,
# run once with NODE_ENV=development and this empty, then message the bot.
ALLOWED_TELEGRAM_USER_ID=

# ---- proactive digest ----
# Exactly "true" or "false". Default is false, so it is listed here to keep it on.
DIGEST_ENABLED=true
